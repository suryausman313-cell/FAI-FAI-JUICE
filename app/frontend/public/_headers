# Fai Fai customer app: fresh HTML/DAL, long-lived hashed assets.
# This avoids stale app-shell behaviour while keeping repeat launches fast.

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/customer-sw.js
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate

/.well-known/assetlinks.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
